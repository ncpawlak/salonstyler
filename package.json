{
  "name": "chairside",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run web --workspace @chairside/mobile --",
    "ios": "npm run ios --workspace @chairside/mobile --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "react-native-gesture-handler": "~3.3.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
