# Hosted Supabase settings for the go-live scripts (docs/pilot-cutover.md, section 3).
#
#   cp .env.hosted.example .env.hosted        (PowerShell: Copy-Item .env.hosted.example .env.hosted)
#
# .env.hosted is gitignored. Never commit it, paste it in chat, or put these values in the app.
# The scripts only ever print key names, never values.
#
# Legend: [required] the pilot doesn't work without it
#         [recommended] a feature is off or degraded without it
#         [optional] has a default; leave empty unless you need it
# Empty values are skipped (an existing hosted value is left as is).

# ---------------------------------------------------------------------------------------------
# Tooling (read by the scripts, NOT sent to the functions)
# ---------------------------------------------------------------------------------------------

# [required] Project ref: the 20-letter id in https://<ref>.supabase.co (Project Settings → General).
SUPABASE_PROJECT_REF=

# [recommended] Personal access token (supabase.com/dashboard/account/tokens). Lets the scripts run
# without `npx supabase login` and is needed by hosted:auth and the auth checks in hosted:verify.
SUPABASE_ACCESS_TOKEN=

# [recommended] Database password chosen when the project was created. Lets `db push` run without a
# prompt. Reset it in Project Settings → Database if lost.
SUPABASE_DB_PASSWORD=

# [recommended] Session pooler connection string (dashboard → Connect → Session pooler). The direct
# database host is IPv6-only; most home/office networks need this for `db push` / `db query`.
# Keep [YOUR-PASSWORD] as is: it's filled from SUPABASE_DB_PASSWORD.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------------------------
# Edge Function secrets (npm run hosted:secrets). SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY are provided by the platform: don't set them.
# ---------------------------------------------------------------------------------------------

# [required] Random shared secret for pg_cron → notifier / waitlist / marketing. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# `npm run hosted:vault -- --apply` copies it into Vault as notifier_secret.
NOTIFIER_SECRET=

# [optional] Expo access token, only if push "enhanced security" is on in the Expo project.
EXPO_ACCESS_TOKEN=

# --- Client email (confirmations, reminders, waitlist offers, marketing, data-export links) -----
# Without EMAIL_FROM + PUBLIC_APP_URL + a provider, these emails stay queued. Pushes still work.
# supabase/docs/client-self-service.md

# [recommended] Sender. The domain must be verified with the provider.
EMAIL_FROM="Your Salon <hello@yourdomain.com>"
# [recommended] Public web app origin (where the Expo web build is hosted), no trailing slash.
PUBLIC_APP_URL=https://app.yourdomain.com
# [recommended] Resend API key (re_…). Preferred over SMTP. hosted:auth also uses it for Auth emails.
RESEND_API_KEY=

# [optional] SMTP instead of Resend (hosted functions often can't reach SMTP ports).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# [optional] tls | starttls | none (default: tls on 465, starttls otherwise)
SMTP_SECURITY=

# --- Stripe (Connect onboarding, card checkout, deposits). Use TEST keys for the pilot ---------
# supabase/docs/payments.md. Without STRIPE_SECRET_KEY, card actions return 503 stripe_not_configured.

# [recommended] Platform secret key: sk_test_… (sk_live_… only at the go-live step).
STRIPE_SECRET_KEY=
# [recommended] Signing secrets of BOTH webhook destinations (your account + connected accounts),
# comma-separated, no spaces: whsec_platform…,whsec_connect…
STRIPE_WEBHOOK_SECRET=
# [recommended] https page Stripe onboarding returns to from iOS. Empty = PUBLIC_APP_URL/settings/payments.
PAYMENTS_RETURN_URL=
# [optional] Origin deposits may return to after Stripe Checkout. Empty = PUBLIC_APP_URL.
PUBLIC_WEB_URL=
# [optional] Two-letter country for new Connect accounts. Empty = US.
STRIPE_CONNECT_COUNTRY=
# [optional] Fixed Stripe Terminal location (tml_…). Empty = one is created per salon.
STRIPE_TERMINAL_LOCATION_ID=

# --- Marketing ---------------------------------------------------------------------------------
# [optional] One-click unsubscribe endpoint. Empty = https://<ref>.supabase.co/functions/v1/marketing.
PUBLIC_FUNCTIONS_URL=

# ---------------------------------------------------------------------------------------------
# Never on hosted (local stack only): CHAIRSIDE_AI_DEMO, PUBLIC_SUPABASE_URL.
# AI provider keys are NOT function secrets: the stylist enters his own in Settings → AI assistant
# (stored per salon in Vault).
# ---------------------------------------------------------------------------------------------
