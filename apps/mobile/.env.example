# Copy to apps/mobile/.env. Local values come from `npx supabase status` (API URL + publishable/anon key).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Checkout (#11). See supabase/README.md -> "Checkout and Tap to Pay".
# Public origin for receipt links sent from native builds (web uses its own origin).
# EXPO_PUBLIC_WEB_URL=https://app.example.com
# 1 = real Tap to Pay on iPhone in custom iOS builds. Needs Apple's entitlement; leave unset until granted.
# EXPO_PUBLIC_TAP_TO_PAY=1


# Text bridge (#6). The published "Add to Shortcuts" link for Chairside Bridge (iCloud or a hosted signed .shortcut).
# Unset: setup shows the build-it-yourself recipe. See docs/shortcut-bridge.md.
# EXPO_PUBLIC_BRIDGE_SHORTCUT_URL=https://www.icloud.com/shortcuts/...
