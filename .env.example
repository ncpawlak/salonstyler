# Copy to `.env` (never commit real values).
# Local values are printed by `npx supabase start` / `npx supabase status`.

# Client (safe to ship in the app; RLS protects data)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (Edge Functions, scripts). NEVER expose to the app.
SUPABASE_SERVICE_ROLE_KEY=

# Hosted project (for `supabase link` / `gen types --project-id`)
SUPABASE_PROJECT_REF=

# Sign in with Apple (read by supabase/config.toml). See supabase/README.md.
# Comma-separated: iOS bundle id, then the web Services ID.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Optional: only for re-recording AI contract fixtures (packages/ai). Never commit real keys.
# Salon AI keys are entered in the app and stored in Supabase Vault, not here.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Stripe Connect (payments). These are Edge Function secrets, NOT app env vars: put them in
# supabase/functions/.env for `supabase functions serve --env-file`, and set them on the hosted
# project with `npx supabase secrets set`. See supabase/README.md -> Payments.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # comma-separate several destinations' secrets
# PAYMENTS_RETURN_URL=https://...          # where Stripe returns native users after onboarding
# STRIPE_CONNECT_COUNTRY=US
# STRIPE_TERMINAL_LOCATION_ID=tml_...     # optional; otherwise one is created per salon from its address
